# ==========================================
# STAGE 1: BUILDER (Monorepo Root Context)
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# 1. Copy the entire monorepo into the builder
# (Ensure you have a .dockerignore at the root ignoring local node_modules!)
COPY . .

# 2. Install dependencies across the entire monorepo (respects root package-lock.json)
RUN npm ci

# 3. Build ONLY the web/portal workspace
RUN npm run build -w web/portal

# ==========================================
# STAGE 2: RUNNER (Nginx)
# ==========================================
FROM nginx:alpine

# Generate self-signed SSL cert with SAN (IP) — required by Chrome/Edge/Brave
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/ssl && \
    printf '[req]\ndistinguished_name=req_dn\nx509_extensions=v3\nprompt=no\n[req_dn]\nCN=erm-platform\n[v3]\nsubjectAltName=DNS:erm.prod,DNS:erm-platform,IP:127.0.0.1,DNS:localhost\n' > /tmp/cert.cfg && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/key.pem \
    -out /etc/nginx/ssl/cert.pem \
    -config /tmp/cert.cfg && \
    rm /tmp/cert.cfg && \
    apk del openssl

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# 🚨 PATH UPDATE: Because context is root, we specify the full path to nginx.conf
COPY web/portal/nginx.conf /etc/nginx/conf.d/default.conf

# 🚨 PATH UPDATE: Extract the compiled assets from the portal workspace folder
COPY --from=builder /app/web/portal/dist /usr/share/nginx/html

EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]