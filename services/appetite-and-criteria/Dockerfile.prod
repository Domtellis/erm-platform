# ==========================================
# STAGE 1: BUILDER (Monorepo Root Context)
# ==========================================
FROM node:20-slim AS builder

# Debian-slim sometimes requires openssl for Prisma to generate correctly
RUN apt-get update && apt-get install -y openssl

WORKDIR /app

# 1. Copy the entire monorepo (shielded by your new .dockerignore!)
COPY . .

# 2. Install ALL dependencies across the monorepo workspaces
RUN npm ci

# 3. Generate Prisma client natively
# We use the exact environment variables from your original file
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=library
ENV PRISMA_CLIENT_ENGINE_TYPE=library
RUN npx prisma generate --schema=./services/appetite-and-criteria/schema.prisma

# 4. Build ONLY the appetite-and-criteria workspace
RUN npm run build -w services/appetite-and-criteria


# ==========================================
# STAGE 2: RUNNER (Production Image)
# ==========================================
FROM node:20-slim AS runner

# Ensure openssl is available in production for the Prisma engine
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=library
ENV PRISMA_CLIENT_ENGINE_TYPE=library

# 1. Copy the root lockfile and workspace package.json
COPY package.json package-lock.json ./
COPY services/appetite-and-criteria/package.json ./services/appetite-and-criteria/

# 2. Install ONLY production dependencies across the workspace
RUN npm ci --omit=dev

# 3. Copy the compiled Prisma Client from the builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

# 4. Copy the compiled Javascript and Prisma files from the builder
COPY --from=builder /app/services/appetite-and-criteria/dist ./services/appetite-and-criteria/dist
COPY --from=builder /app/services/appetite-and-criteria/schema.prisma ./services/appetite-and-criteria/schema.prisma

# 5. Drop down into the specific service directory to run the app
WORKDIR /app/services/appetite-and-criteria

EXPOSE 4012

CMD ["node", "dist/main"]