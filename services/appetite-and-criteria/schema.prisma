generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/@prisma-clients/appetite"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["appetite"]
}

model AppetiteStatement {
  id              String       @id @default(uuid())
  title           String
  description     String
  category        String
  version         String
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  thresholds      Threshold[]

  @@schema("appetite")
}

model Threshold {
  id              String             @id @default(uuid())
  appetite_id     String
  appetite        AppetiteStatement  @relation(fields: [appetite_id], references: [id])
  metric_name     String
  display_name    String?
  description     String?
  operator        String             // e.g. ">", "<", "="
  limit_value     Float
  severity_mapping Json              // e.g. {"0.8": "low", "1.0": "medium", "1.2": "high"}

  @@schema("appetite")
}
