      "post": {
        "operationId": "MonitoringController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBreachSubmissionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Manually submit a breach signal/case",
        "tags": [
          "Monitoring & Breaches"
        ]
      }
    },
    "/breaches/metrics": {
      "get": {
        "operationId": "MonitoringController_getMetrics",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current breach metrics and compliance",
        "tags": [
          "Monitoring & Breaches"
        ]
      }
    },
    "/breaches": {
      "get": {
        "operationId": "MonitoringController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List all breach cases",
        "tags": [
          "Monitoring & Breaches"
        ]
      }
    },
    "/breaches/{id}": {
      "get": {
        "operationId": "MonitoringController_findOne",
