  "info": {
    "title": "Monitoring & Breaches API",
    "description": "The ERM Monitoring & Breaches domain service API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateBreachSubmissionDto": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "example": "PORT-TERM-04"
          },
          "metric_name": {
            "type": "string",
            "example": "wind_speed_knots"
          },
          "observed_value": {
            "type": "number",
            "example": 48.5
          },
          "title": {
            "type": "string",
            "example": "High Wind Gusts at Quay 4"
          },
          "category": {
            "type": "string",
            "example": "safety"
          },
          "bu_id": {
            "type": "string",
            "example": "BU-PACIFIC"
          },
          "severity": {
            "type": "string",
            "example": "critical"
          }
        },
        "required": [
          "site_id",
          "metric_name",
          "observed_value",
          "category",
          "bu_id"
        ]
      }
    }
  }
}