# ==========================================
# STAGE 1: PRUNER (Isolate workspace)
# ==========================================
FROM node:20-slim AS pruner
WORKDIR /app
RUN npm install -g turbo
COPY . .
# Extract only the monitoring-and-breaches workspace and its internal dependencies
RUN turbo prune monitoring-and-breaches --docker

# ==========================================
# STAGE 2: BUILDER (Compile)
# ==========================================
FROM node:20-slim AS builder
WORKDIR /app

# Install openssl for Prisma
RUN apt-get update && apt-get install -y openssl

# 1. Copy pruned package.json and lockfile
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json

# 2. Install ALL dependencies for build
RUN npm ci

# 3. Copy source code and generate Prisma Client
COPY --from=pruner /app/out/full/ .
COPY services/monitoring-and-breaches/schema.prisma ./services/monitoring-and-breaches/schema.prisma

ENV PRISMA_CLI_QUERY_ENGINE_TYPE=library
ENV PRISMA_CLIENT_ENGINE_TYPE=library
RUN npx prisma generate --schema=./services/monitoring-and-breaches/schema.prisma

# 4. Build the workspace
RUN npm run build -w services/monitoring-and-breaches

# ==========================================
# STAGE 3: RUNNER (Production Image)
# ==========================================
FROM node:20-slim AS runner
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production

# 1. Copy pruned manifests for production install
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json

# 2. Install ONLY production dependencies
RUN npm ci --omit=dev

# 3. Copy compiled Prisma Client and Dist files
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/services/monitoring-and-breaches/dist ./services/monitoring-and-breaches/dist
COPY --from=builder /app/services/monitoring-and-breaches/schema.prisma ./services/monitoring-and-breaches/schema.prisma

# 4. Workspace setup
WORKDIR /app/services/monitoring-and-breaches
EXPOSE 4010

CMD ["node", "dist/main"]