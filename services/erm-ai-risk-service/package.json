{
    "name": "erm-ai-risk-service",
    "version": "1.0.0",
    "description": "ERM AI Risk Assessment Service — Gemini-powered ISO 45001 risk scoring",
    "main": "index.js",
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --watch --debug",
        "start:prod": "node dist/main",
        "build": "nest build -p tsconfig.build.json",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --passWithNoTests",
        "test:cov": "jest --coverage",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "@nestjs/common": "^11.1.13",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.13",
        "@nestjs/microservices": "^11.1.13",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.13",
        "@nestjs/swagger": "^11.2.6",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.69.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
        "@opentelemetry/resources": "^2.5.1",
        "@opentelemetry/sdk-metrics": "^2.5.1",
        "@opentelemetry/sdk-node": "^0.212.0",
        "@opentelemetry/semantic-conventions": "^1.39.0",
        "@prisma/client": "^5.22.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "joi": "^18.0.2",
        "jwks-rsa": "^3.2.2",
        "kafkajs": "^2.2.4",
        "kafkajs-snappy": "^1.1.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "snappy": "^7.3.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.16",
        "@nestjs/testing": "^11.1.13",
        "@types/express": "^5.0.6",
        "@types/node": "^25.2.2",
        "@types/passport-jwt": "^4.0.1",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "prettier": "^3.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.(t|j)s"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/src/$1"
        }
    }
}