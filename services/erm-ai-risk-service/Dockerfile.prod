# ==========================================
# STAGE 1: PRUNER
# ==========================================
FROM node:20-slim AS pruner
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune erm-ai-risk-service --docker

# ==========================================
# STAGE 2: BUILDER
# ==========================================
FROM node:20-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y openssl
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci
COPY --from=pruner /app/out/full/ .
COPY services/erm-ai-risk-service/schema.prisma ./services/erm-ai-risk-service/schema.prisma
RUN npx prisma generate --schema=./services/erm-ai-risk-service/schema.prisma
RUN npm run build -w services/erm-ai-risk-service

# ==========================================
# STAGE 3: RUNNER
# ==========================================
FROM node:20-slim AS runner
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --omit=dev
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/services/erm-ai-risk-service/dist ./services/erm-ai-risk-service/dist
COPY --from=builder /app/services/erm-ai-risk-service/schema.prisma ./services/erm-ai-risk-service/schema.prisma
WORKDIR /app/services/erm-ai-risk-service
EXPOSE 4014
CMD ["node", "dist/main"]