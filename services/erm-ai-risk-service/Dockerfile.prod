# Build is handled natively in CI to avoid QEMU slowness
FROM node:20-slim

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm install --omit=dev

# Copy natively built app
COPY ./dist ./dist
# AI Risk service does not use Prisma (confirmed from previous view)

EXPOSE 4014

CMD ["node", "dist/main"]
