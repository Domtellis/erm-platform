# Build is handled natively in CI to avoid QEMU slowness
FROM node:20-slim

WORKDIR /app

# Install production dependencies only
# Note: using npm install (not ci) because this service's lock file predates OTel deps
COPY package*.json ./
RUN npm install --omit=dev

# Copy natively built app
COPY ./dist ./dist

EXPOSE 4020

CMD ["node", "dist/main"]
