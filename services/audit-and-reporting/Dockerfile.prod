# ==========================================
# STAGE 1: PRUNER
# ==========================================
FROM node:20-slim AS pruner
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune audit-and-reporting --docker

# ==========================================
# STAGE 2: BUILDER
# ==========================================
FROM node:20-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y openssl
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --ignore-scripts
COPY --from=pruner /app/out/full/ .
COPY services/audit-and-reporting/schema.prisma ./services/audit-and-reporting/schema.prisma
RUN npx prisma generate --schema=./services/audit-and-reporting/schema.prisma
RUN npm run build -w services/audit-and-reporting

# ==========================================
# STAGE 3: RUNNER
# ==========================================
FROM node:20-slim AS runner
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --omit=dev --ignore-scripts
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/services/audit-and-reporting/dist ./services/audit-and-reporting/dist
COPY --from=builder /app/services/audit-and-reporting/schema.prisma ./services/audit-and-reporting/schema.prisma
WORKDIR /app/services/audit-and-reporting
EXPOSE 4013
CMD ["node", "dist/main"]