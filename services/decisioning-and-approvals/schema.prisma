generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/@prisma-clients/decisioning"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["decisioning"]
}

model Decision {
  id              String     @id @default(uuid())
  breach_case_id  String
  decision_type   String
  rationale       String
  status          String     @default("pending")
  submitted_by    String
  created_at      DateTime   @default(now())
  approvals       Approval[]
  evidence        Evidence[]

  @@schema("decisioning")
}

model Approval {
  id              String   @id @default(uuid())
  decision_id     String
  decision        Decision @relation(fields: [decision_id], references: [id])
  approver_user_id String
  approver_role   String
  status          String   @default("approved")
  approved_at     DateTime @default(now())
  sod_check_passed Boolean

  @@schema("decisioning")
}

model Outbox {
  id              String   @id @default(uuid())
  type            String
  payload         Json
  occurred_at     DateTime @default(now())
  processed_at    DateTime?

  @@schema("decisioning")
}

model RiskAssessment {
  id              String   @id @default(uuid())
  breach_case_id  String   // Link to Monitoring Breach
  title           String
  summary         String?
  impact_score    Int      // 1-5
  likelihood_score Int     // 1-5
  risk_level      String   // Low, Medium, High, Critical
  assessed_by     String   // User ID
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  remediations    RemediationPlan[]
  @@schema("decisioning")
}

model RemediationPlan {
  id                String   @id @default(uuid())
  risk_assessment_id String
  risk_assessment   RiskAssessment @relation(fields: [risk_assessment_id], references: [id])
  title             String
  description       String
  assigned_to       String   // User ID
  due_date          DateTime
  status            String   // open, in_progress, completed
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@schema("decisioning")
}

model Evidence {
  id            String   @id @default(uuid())
  decision_id   String
  decision      Decision @relation(fields: [decision_id], references: [id])
  url           String
  description   String?
  uploaded_by   String
  uploaded_at   DateTime @default(now())

  @@schema("decisioning")
}
