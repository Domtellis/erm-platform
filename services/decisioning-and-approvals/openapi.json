  "info": {
    "title": "Decisioning & Approvals API",
    "description": "The ERM Decisioning & Approvals domain service API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateDecisionDto": {
        "type": "object",
        "properties": {
          "breach_case_id": {
            "type": "string",
            "example": "BC-2026-001"
          },
          "decision_type": {
            "type": "string",
            "example": "mitigate",
            "enum": [
              "accept",
              "accept_risk",
              "mitigate",
              "stop",
              "waive"
            ]
          },
          "rationale": {
            "type": "string",
            "example": "Safety protocols activated."
          },
          "submitted_by": {
            "type": "string",
            "example": "USER-99"
          },
          "evidence_urls": {
            "example": [
              "http://example.com/evidence"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "breach_case_id",
          "decision_type",
          "rationale",
          "submitted_by"
        ]
      },
      "ApproveDecisionDto": {
        "type": "object",
        "properties": {
          "approver_user_id": {
            "type": "string",
            "example": "APPROVER-01"
          },
          "approver_role": {
            "type": "string",
            "example": "bu_risk_owner"
          },
          "comments": {
            "type": "string",
            "example": "Approved after site review."
          }
        }
      },
      "CreateRiskAssessmentDto": {
        "type": "object",
        "properties": {
          "breach_case_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "impact_score": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "likelihood_score": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "submitted_by": {
            "type": "string"
          }
        },
        "required": [
          "breach_case_id",
          "title",
          "impact_score",
          "likelihood_score",
          "submitted_by"
        ]
      },
      "CreateRemediationPlanDto": {
        "type": "object",
        "properties": {
          "risk_assessment_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          }
        },
        "required": [
          "risk_assessment_id",
          "title",
          "description",
          "assigned_to",
          "due_date"
        ]
      }
    }
  }
}