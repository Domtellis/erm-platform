# Build is handled natively in CI to avoid QEMU slowness
FROM node:20-slim

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev

# Copy natively built app
COPY ./dist ./dist
COPY ./schema.prisma ./schema.prisma

# Generate Prisma client for the target architecture (Native Engine)
RUN PRISMA_CLI_QUERY_ENGINE_TYPE=library PRISMA_CLIENT_ENGINE_TYPE=library npx prisma generate --schema=./schema.prisma

EXPOSE 4011

CMD ["node", "dist/src/main"]

