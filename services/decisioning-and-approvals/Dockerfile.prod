# ==========================================
# STAGE 1: PRUNER
# ==========================================
FROM node:20-slim AS pruner
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune decisioning-and-approvals --docker

# ==========================================
# STAGE 2: BUILDER
# ==========================================
FROM node:20-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y openssl
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --ignore-scripts
COPY --from=pruner /app/out/full/ .
COPY services/decisioning-and-approvals/schema.prisma ./services/decisioning-and-approvals/schema.prisma
RUN npx prisma generate --schema=./services/decisioning-and-approvals/schema.prisma
RUN npm run build -w services/decisioning-and-approvals

# ==========================================
# STAGE 3: RUNNER
# ==========================================
FROM node:20-slim AS runner
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --omit=dev --ignore-scripts
COPY --from=builder /app/node_modules/@prisma/client/decisioning ./node_modules/@prisma/client/decisioning
COPY --from=builder /app/services/decisioning-and-approvals/dist ./services/decisioning-and-approvals/dist
COPY --from=builder /app/services/decisioning-and-approvals/schema.prisma ./services/decisioning-and-approvals/schema.prisma
WORKDIR /app/services/decisioning-and-approvals
EXPOSE 4011
CMD ["node", "dist/main"]