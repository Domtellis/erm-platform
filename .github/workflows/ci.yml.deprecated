name: Monorepo CI/CD Pipeline

on:
  push:
    branches: [ main ]
    paths-ignore:
      - 'docs/**'
      - '**.md'
      - '**.mmd'
      - '.gitignore'
      - 'LICENSE'
      - 'tools/**'
      - '.github/workflows/tests_models.yml'

  pull_request:
    branches: [ main ]
    paths-ignore:
      - 'docs/**'
      - '**.md'
      - '**.mmd'
      - '.gitignore'
      - 'LICENSE'
      - 'tools/**'
      - '.github/workflows/tests_models.yml'

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    name: Build, Lint & Test
    runs-on: ubuntu-latest
    outputs:
      owner: ${{ steps.owner.outputs.owner }}
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          npm install -g npm@latest
          npm ci --include=dev --legacy-peer-deps
          npm run install:binaries
          make install

      - name: Build Monorepo (Direct)
        run: |
          npm install
          echo "CLEANING STALE DIST FOLDERS"
          rm -rf services/*/dist web/*/dist
          echo "RUNNING BUILDS MANUALLY TO BYPASS TURBO CACHE ISSUES"
          SERVICES=(
            "services/appetite-and-criteria"
            "services/audit-and-reporting"
            "services/decisioning-and-approvals"
            "services/erm-ai-risk-service"
            "services/monitoring-and-breaches"
            "services/notification-service"
            "web/portal"
          )
          
          for S in "${SERVICES[@]}"; do
            echo "--- BUILDING $S ---"
            cd $S
            npm run build
            cd ../..
          done

      - name: Audit Build Outputs (Granular)
        run: |
          SERVICES=(
            "services/appetite-and-criteria"
            "services/audit-and-reporting"
            "services/decisioning-and-approvals"
            "services/erm-ai-risk-service"
            "services/monitoring-and-breaches"
            "services/notification-service"
            "web/portal"
          )
          
          FAILED=0
          for S in "${SERVICES[@]}"; do
            if [ ! -d "$S/dist" ]; then
              echo "::error::MISSING DIST: $S/dist not found!"
              FAILED=1
            else
              echo "OK: $S/dist exists"
            fi
          done
          
          if [ $FAILED -ne 0 ]; then
            echo "FATAL: One or more services failed to build dist folders."
            exit 1
          fi

      - name: Pack Build Artifacts (Total Capture)
        run: |
          # Simple, robust capture of all relevant folders
          # We exclude node_modules to keep it small, but capture everything else
          tar -czf artifacts.tar.gz \
            services/*/dist \
            services/*/prisma \
            services/*/migrations \
            services/*/Dockerfile.prod \
            services/*/schema.prisma \
            services/*/package.json \
            web/*/dist \
            web/*/Dockerfile.prod \
            web/*/package.json \
            package.json

      - name: Audit Pack Contents
        run: tar -tvf artifacts.tar.gz | head -n 50

      - name: Upload Build Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: dist-artifacts
          path: artifacts.tar.gz
          retention-days: 1

  package:
    name: Build & Push
    needs: verify
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - name: appetite-and-criteria
            path: services/appetite-and-criteria
          - name: audit-and-reporting
            path: services/audit-and-reporting
          - name: decisioning-and-approvals
            path: services/decisioning-and-approvals
          - name: ai-risk-service
            path: services/erm-ai-risk-service
          - name: monitoring-and-breaches
            path: services/monitoring-and-breaches
          - name: notification-service
            path: services/notification-service
          - name: portal
            path: web/portal

    steps:
      - name: Checkout Code (for Dockerfiles)
        uses: actions/checkout@v4

      - name: Lowercase repository owner
        id: owner
        run: echo "owner=${GITHUB_REPOSITORY_OWNER,,}" >> $GITHUB_OUTPUT

      - name: Download Build Artifacts
        uses: actions/download-artifact@v4
        with:
          name: dist-artifacts
          path: .

      - name: Unpack Build Artifacts
        run: |
          tar -xzf artifacts.tar.gz -C .
          echo "Verifying unpack results for ${{ matrix.path }}..."
          ls -R ${{ matrix.path }}/dist || echo "DIST STILL MISSING IN UNPACK"

      - name: Audit Docker Context
        run: |
          echo "Listing files in context: ./${{ matrix.path }}"
          ls -la ./${{ matrix.path }}

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and Push
        uses: docker/build-push-action@v5
        with:
          context: ./${{ matrix.path }}
          file: ./${{ matrix.path }}/Dockerfile.prod
          push: true
          platforms: linux/amd64,linux/arm64
          tags: |
            ghcr.io/${{ steps.owner.outputs.owner }}/erm-${{ matrix.name }}:latest
            ghcr.io/${{ steps.owner.outputs.owner }}/erm-${{ matrix.name }}:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=min

  deploy:
    name: Deploy to OCI
    needs: [verify, package]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Prepare & Audit Target Directory
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.OCI_SERVER_IP }}
          username: ${{ secrets.OCI_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            echo "--- REMOTE AUDIT & CLEANUP START ---"
            df -h /
            # Emergency Prune: Remove unused Docker data to reclaim space
            sudo docker system prune -af --volumes || true
            mkdir -p ~/erm-platform
            sudo chown -R ${{ secrets.OCI_USER }}:${{ secrets.OCI_USER }} ~/erm-platform
            chmod -R 755 ~/erm-platform
            df -h /
            tar --version
            echo "--- REMOTE AUDIT & CLEANUP END ---"

      - name: Copy Config to Server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.OCI_SERVER_IP }}
          username: ${{ secrets.OCI_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          source: "infra,policy,observability,web/portal/nginx.conf"
          target: "/home/${{ secrets.OCI_USER }}/erm-platform"
          overwrite: true
          debug: true

      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          JIRA_URL: ${{ secrets.JIRA_URL }}
          JIRA_USER: ${{ secrets.JIRA_USER }}
          JIRA_TOKEN: ${{ secrets.JIRA_TOKEN }}
          DB_PASSWORD: ${{ secrets.DB_PASSWORD }}
        with:
          host: ${{ secrets.OCI_SERVER_IP }}
          username: ${{ secrets.OCI_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          envs: GEMINI_API_KEY,JIRA_URL,JIRA_USER,JIRA_TOKEN,DB_PASSWORD
          script: |
            cd ~/erm-platform
            
            # Sync Server Firewall — ensure insertion at top to override REJECT rules
            sudo iptables -I INPUT 1 -m state --state NEW -p tcp --match multiport --dports 5180,3000,8080,16686,8025,4010,4011,4012,4013,4014,4020 -j ACCEPT && sudo netfilter-persistent save
            
            # Login to GHCR
            echo ${{ secrets.GITHUB_TOKEN }} | sudo docker login ghcr.io -u ${{ github.actor }} --password-stdin
            
            # Start the platform
            cd infra/local
            
            # Formulate .env file so docker-compose seamlessly injects secrets into containers
            echo "GEMINI_API_KEY=$GEMINI_API_KEY" > .env
            echo "JIRA_URL=$JIRA_URL" >> .env
            echo "JIRA_USER=$JIRA_USER" >> .env
            echo "JIRA_TOKEN=$JIRA_TOKEN" >> .env
            echo "DB_PASSWORD=${DB_PASSWORD:-password}" >> .env

            sudo docker-compose -f docker-compose.prod.yml pull
            
            # Ensure databases exist before starting dependent services
            sudo docker-compose -f docker-compose.prod.yml up -d postgres
            sleep 10
            sudo docker exec erm-postgres psql -U postgres -c "CREATE DATABASE audit;" || true
            sudo docker exec erm-postgres psql -U postgres -c "CREATE DATABASE ai_risk;" || true

            sudo docker-compose -f docker-compose.prod.yml up -d --force-recreate --remove-orphans
            
            # Verify Audit Service Health
            echo "Verifying Audit Service Health..."
            max_retries=30
            count=0
            until [ $(curl -s -o /dev/null -w "%{http_code}" http://localhost:4013/audit/health) -eq 200 ] || [ $count -eq $max_retries ]; do
              echo "Waiting for Audit service... ($count/$max_retries)"
              sleep 5
              count=$((count+1))
            done
            if [ $count -eq $max_retries ]; then
              echo "::error::Audit service failed health check!"
              sudo docker-compose -f docker-compose.prod.yml logs audit-service
              exit 1
            fi
            echo "Audit service is healthy."

            # Ensure Keycloak SSL is disabled for HTTP deployments (idempotent)
            sleep 15
            sudo docker exec erm-postgres psql -U postgres -d keycloak -c "UPDATE realm SET ssl_required='NONE' WHERE name='erm-platform';" || true
