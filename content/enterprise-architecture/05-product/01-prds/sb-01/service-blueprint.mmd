%% SB-01 Service Blueprint -Safety
%% Layers represented as lanes: Frontstage, Backstage, Systems, Data, Controls

subgraph Frontstage["Frontstage - People"]
  IL1["Incident Lead\n - Create/Receive Safety breach"]
  AI1["AI Risk Service\n - Generate triage suggestion"]
  IL2["Incident Lead\n - Triage: confirms AI suggestion, set severity"]
  RL1["Risk Lead\n - Validate vs Appetite/Threshold"]
  BU1["BU Risk Owner\n - Approve High severity decision"]
  IL3["Incident Lead\n - Execute action plan + capture completion evidence"]
  RL2["Risk Lead\n - Close case + export audit pack"]
end

subgraph Backstage["Backstage - Platform behaviours"]
  P1["Auto-assign case ID + initial state = Detected"]
  P2["Compute SLA timers + notify stakeholders"]
  P3["Threshold evaluation engine\n - compare measurement vs threshold"]
  P4["Auto-escalation rules\n - severity/threshold/delegation"]
  P5["Approval workflow\n - SoD enforced "]
  P6["Audit event emission\n - append-only timeline"]
  P7["Evidence policy checks\n - block transitions if missing"]
  P8["Audit pack generator\n -PDF/ZIP export"]
end

subgraph Systems["Systems / Integrations"]
  S1["Manual UI"]
  S2["Monitoring Stub Webhook\n - breach-detected"]
  S3["Notification Service\n - Email / Jira"]
  S7["AI Risk Service\n - Gemini 2.0 API"]
  S4["Identity Provider\n - AAD/Okta"]
  S5["Evidence Store\n - object storage"]
  S6["Audit Log Store\n - append-only"]
end

subgraph Data["Data / Entities"]
  D1["BreachCase"]
  D2["BreachSignal"]
  D3["AppetiteStatementVersion + Threshold"]
  D4["Evaluation"]
  D5["Decision + Approval"]
  D6["ActionItem"]
  D7["EvidenceItem"]
  D8["AuditEvent"]
end

subgraph Controls["Controls / Governance"]
  C1["SoD: creator ≠ approver\n - High severity approver=BU Risk Owner"] 
  C2["Evidence bundle required by severity"]
  C3["Immutable audit trail for key actions"]
  C4["Retention policy for Safety records"]
end

%% Flow connections
S1 --> IL1
