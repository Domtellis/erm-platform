P3 --> D3
P3 --> P4

P4 --> RL1
P4 --> BU1

BU1 --> P5 --> D5
P5 --> C1
P5 --> P6 --> D8 --> S6

IL3 --> D6
IL3 --> D7 --> S5
P7 --> C2
P7 --> P6

RL2 --> P8 --> C3
P8 --> C4
P8 --> S1
