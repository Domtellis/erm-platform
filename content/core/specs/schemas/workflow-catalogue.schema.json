{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/workflow-catalogue.schema.json",
    "title": "ERM Workflow Catalogue",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "workflows"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
        },
        "workflows": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/workflow_summary"
            }
        }
    },
    "$defs": {
        "workflow_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "workflow_id",
                "name"
            ],
            "properties": {
                "workflow_id": {
                    "type": "string",
                    "pattern": "^(WF|wf)-[a-zA-Z0-9-]+$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}