erDiagram
  BoardPack ||--o{ BoardPackPortfolioLink : includesView
  RiskPortfolioView ||--o{ BoardPackPortfolioLink : includedInPack

  BoardPack ||--o{ BoardPackDecisionLink : includesDecision
  DecisionLedgerEntry ||--o{ BoardPackDecisionLink : includedInPack

  Disclosure ||--o{ DisclosureEvidenceLink : referencesEvidence
  EvidenceItem ||--o{ DisclosureEvidenceLink : supportsDisclosure

  Disclosure ||--o{ DisclosureRiskLink : referencesRisk
  Risk ||--o{ DisclosureRiskLink : referencedByDisclosure

  Disclosure ||--o{ DisclosureIncidentLink : referencesIncident
  Incident ||--o{ DisclosureIncidentLink : referencedByDisclosure

  BoardPack ||--o{ BoardPackSignOffLink : signedOffVia
  Disclosure ||--o{ DisclosureApprovalLink : approvedVia
