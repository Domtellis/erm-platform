{
  "name": "erm-platform-root",
  "version": "1.1.0",
  "private": true,
  "description": "Enterprise Risk Management Platform Monorepo Root",
  "scripts": {
    "build:all": "turbo run build",
    "test:all": "turbo run test",
    "lint:all": "turbo run lint",
    "clean": "turbo run clean",
    "install:binaries": "node scripts/install-pact.js",
    "prepare": "husky"
  },
  "workspaces": [
    "services/*",
    "web/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/cli": "^11.0.0",
    "turbo": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "services/**/*.ts": [
      "eslint --fix",
      "jest --passWithNoTests --findRelatedTests"
    ],
    "libs/**/*.ts": [
      "eslint --fix",
      "jest --passWithNoTests --findRelatedTests"
    ],
    "web/portal/**/*.{ts,tsx}": [
      "npm run lint -w web/portal --"
    ]
  },
  "author": "Antigravity",
  "packageManager": "npm@11.1.0"
}