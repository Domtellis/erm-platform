{
    "name": "@erm/testing",
    "version": "1.0.0",
    "private": true,
    "main": "src/index.ts",
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@testcontainers/postgresql": "^11.12.0",
        "testcontainers": "^11.12.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    },
    "devDependencies": {
        "typescript": "^5.3.3"
    }
}